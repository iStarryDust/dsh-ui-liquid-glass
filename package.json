{
  "name": "@istarry/dsh-ui-liquid-glass",
  "description": "全液态玻璃界面 ui-liquid-glass + 壁纸/主题/控件控制器",
  "version": "0.1.1",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README*.md",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "assets/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iStarryDust/dsh-ui-liquid-glass.git"
  },
  "homepage": "https://github.com/iStarryDust/dsh-ui-liquid-glass",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "glass",
    "liquid-glass",
    "theme",
    "wallpaper"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  }
}
